# ──────────────────────────────────────────────────────────────────
# DEVELOPMENT ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# Never commit .env to git
# ──────────────────────────────────────────────────────────────────

# ─── Cloudflare (for deployment) ────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
CLOUDFLARE_D1_DATABASE_ID=d1_database_id_from_wrangler_d1_create

# ─── Cloudflare Worker ──────────────────────────────────────────
WORKER_ENVIRONMENT=development
WORKER_URL=http://localhost:8787
WORKER_RETENTION_DAYS=90
# Admin secret used ONLY to mint/revoke per-tenant API keys via /v1/keys.
# Set with: wrangler secret put ADMIN_SECRET
WORKER_ADMIN_SECRET=local_dev_admin_secret_change_in_production

# ─── ObserveOS SDK (use in your test app) ───────────────────────
# Mint a real key first: curl -X POST http://localhost:8787/v1/keys \
#   -H "Authorization: Bearer $WORKER_ADMIN_SECRET" \
#   -d '{"tenantId":"test_tenant","name":"local dev"}'
OBSERVEOS_API_KEY=obs_your_minted_key
OBSERVEOS_BASE_URL=http://localhost:8787
OBSERVEOS_TENANT_ID=test_tenant
OBSERVEOS_ENVIRONMENT=development
OBSERVEOS_DEBUG=true

# ─── Next.js Dashboard ───────────────────────────────────────────
# Public — safe to expose to the browser bundle.
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
# Server-side only (used by functions/api/[[path]].ts, the Pages Function
# proxy). Configure as Pages project secrets in production — never prefix
# with NEXT_PUBLIC_ or it will be bundled into client-side JS.
WORKER_API_KEY=obs_your_minted_key
WORKER_TENANT_ID=test_tenant
