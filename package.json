{
  "name": "observeos",
  "version": "0.1.0",
  "description": "Open-source, self-hosted LLM observability platform. Trace OpenAI, Anthropic, Ollama, and Hugging Face calls with token cost tracking, latency monitoring, and error tracing. TypeScript-native and OpenTelemetry-compatible.",
  "keywords": [
    "llm-observability",
    "ai-monitoring",
    "openai",
    "anthropic",
    "ollama",
    "huggingface",
    "llm-tracing",
    "opentelemetry",
    "self-hosted",
    "open-source",
    "cloudflare-workers",
    "typescript"
  ],
  "private": true,
  "packageManager": "npm@10.8.2",
  "license": "MIT",
  "author": "Abdul Mueez <abdulmoiz3140@gmail.com>",
  "homepage": "https://github.com/Abdul-Moiz31/ObserveOS",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdul-Moiz31/ObserveOS.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo dist",
    "deploy": "turbo run deploy"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dotenv": "^8.2.0",
    "eslint": "^8.0.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
